{
  "name": "dsh-plugin-antigravity",
  "version": "1.3.2",
  "description": "Google Antigravity & OpenAI Codex LLM provider plugin for DeepSeek Harness (DSH) with Cockpit Tools OAuth integration",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dsh-antigravity-login": "./bin/login.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./typert": "./src/typert.host.js",
    "./remote": "./src/typert.remote.js",
    "./*": "./*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "dsh": {
    "compatibility": {
      "desktop": ">=2.5.0"
    },
    "client": {
      "platform": "web",
      "inject": ["slots", "remote"]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-0",
    "zod": ">=3.0.0 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "antigravity",
    "google",
    "gemini",
    "claude",
    "codex",
    "openai-codex",
    "cockpit-tools",
    "llm-provider"
  ],
  "license": "MIT"
}
